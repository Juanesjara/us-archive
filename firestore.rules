rules_version = '2';

// Access model
// - members/{uid}: one document per person allowed into the archive.
//   Created by hand in the Firebase console. role is "admin" or "member".
// - Everything else is readable by members and writable only by admins,
//   except that any member can add new photos (images + photos create)
//   and change a photo's caption.
// - photos/{id}/comments/{id}: any member comments as themselves; the author
//   or an admin can delete a comment, nobody can edit one.
// - images/{id}: legacy copies of the photos as compressed JPEG data URLs,
//   from before they moved to Cloud Storage (see storage.rules). No longer read.
// - Nothing is public. There is a final deny-all for anything not listed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isMember() {
      return signedIn() && exists(memberPath());
    }

    function isAdmin() {
      return isMember() && get(memberPath()).data.role == 'admin';
    }

    function data() {
      return request.resource.data;
    }

    function optionalString(field, max) {
      return !(field in data()) || data()[field] == null
        || (data()[field] is string && data()[field].size() <= max);
    }

    function optionalId(field) {
      return !(field in data()) || data()[field] == null || data()[field] is string;
    }

    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // managed from the console only
    }

    match /images/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && data().data is string
        && data().data.size() < 1000000
        && data().data.matches('^data:image/jpeg;base64,.*')
        && data().width is int
        && data().height is int;
      allow update: if false; // images are immutable; replacing one creates a new id
      allow delete: if isAdmin();
    }

    function optionalNumber(field) {
      return !(field in data()) || data()[field] == null || data()[field] is number;
    }

    match /photos/{id} {
      allow read: if isMember();
      allow create: if isMember() && validPhoto();
      allow update: if validPhoto() && (isAdmin() || (isMember() && onlyCaptionChanged()));
      allow delete: if isAdmin();

      // Any member comments as themselves; authors and admins delete, nobody edits.
      match /comments/{commentId} {
        allow read: if isMember();
        allow create: if isMember()
          && data().keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && data().uid == request.auth.uid
          && data().name is string && data().name.size() > 0 && data().name.size() <= 60
          && data().text is string && data().text.size() > 0 && data().text.size() <= 500
          && data().createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      }
    }

    // Lets the photo grid count comments with a single collection-group query.
    match /{path=**}/comments/{commentId} {
      allow read: if isMember();
    }

    function onlyCaptionChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption']);
    }

    function validPhoto() {
      return data().imageId is string
        && data().date is timestamp
        && (!('hasTime' in data()) || data().hasTime is bool)
        && optionalString('caption', 200)
        && optionalString('location', 160)
        && optionalString('city', 120)
        && optionalNumber('lat')
        && optionalNumber('lng');
    }

    match /settings/official {
      allow read: if isMember();
      allow write: if isAdmin()
        && data().active is bool
        && optionalId('photoId');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
