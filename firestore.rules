rules_version = '2';

// Access model
// - members/{uid}: one document per person allowed into the archive.
//   Created by hand in the Firebase console. role is "admin" or "member".
// - Everything else is readable by members and writable only by admins.
// - images/{id} holds each photo as a compressed JPEG data URL, so the
//   archive runs on the free Spark plan without Cloud Storage.
// - Nothing is public. There is a final deny-all for anything not listed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isMember() {
      return signedIn() && exists(memberPath());
    }

    function isAdmin() {
      return isMember() && get(memberPath()).data.role == 'admin';
    }

    function data() {
      return request.resource.data;
    }

    function optionalString(field, max) {
      return !(field in data()) || data()[field] == null
        || (data()[field] is string && data()[field].size() <= max);
    }

    function optionalId(field) {
      return !(field in data()) || data()[field] == null || data()[field] is string;
    }

    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // managed from the console only
    }

    match /images/{id} {
      allow read: if isMember();
      allow create: if isAdmin()
        && data().data is string
        && data().data.size() < 1000000
        && data().data.matches('^data:image/jpeg;base64,.*')
        && data().width is int
        && data().height is int;
      allow update: if false; // images are immutable; replacing one creates a new id
      allow delete: if isAdmin();
    }

    match /photos/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && data().imageId is string
        && data().date is timestamp
        && optionalString('caption', 200)
        && optionalString('location', 120);
      allow delete: if isAdmin();
    }

    match /memories/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && data().title is string && data().title.size() <= 120
        && data().date is timestamp
        && optionalString('description', 2000)
        && optionalString('location', 120)
        && optionalId('photoId');
      allow delete: if isAdmin();
    }

    match /places/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && data().name is string && data().name.size() <= 120
        && data().date is timestamp
        && optionalString('note', 1000)
        && optionalId('photoId');
      allow delete: if isAdmin();
    }

    match /things/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && data().title is string && data().title.size() <= 120
        && data().category in ['games', 'books', 'movies', 'songs', 'random']
        && optionalString('note', 1000)
        && (!('date' in data()) || data().date == null || data().date is timestamp);
      allow delete: if isAdmin();
    }

    match /settings/official {
      allow read: if isMember();
      allow write: if isAdmin()
        && data().active is bool
        && optionalId('photoId');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
